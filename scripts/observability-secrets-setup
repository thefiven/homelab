#!/usr/bin/env bash
#
# A wizard — walks a human through a manual procedure step by step.
# Generated by the /wizard skill.
#
# Sources the shared wizard library (scripts/lib/wizard.sh); do not hand-edit
# a wizard's inlined copy of it. After a /wizard regeneration inlines the
# library back in, replace it with this source line before committing.

# shellcheck source=lib/wizard.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/wizard.sh"

# ──────────────────────────────────────────────────────────────────────────
# STAGES: observability secrets (#169, ADR-0018).
#
# Produces two SOPS+age-encrypted Kubernetes Secrets under
# workloads/observability/secrets/, the same shape as
# workloads/immich/secrets/immich-postgres.sops.yaml: the ntfy topic
# Alertmanager's future webhook posts to (ADR-0018: "the topic is the
# credential... pick something that's not easily guessable"), and the three
# Healthchecks.io ping URLs (Watchdog heartbeat, daily PostgreSQL dump,
# monthly restic check).
#
# Wiring these into alertmanager-configmap.yaml's webhook_config and into
# scripts/check is #170's job, not this wizard's — it stops at producing two
# correctly-encrypted, unwired secret files.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=4

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "observability-secrets-setup: run this from inside the homelab git checkout" >&2
  exit 1
}
command -v sops >/dev/null 2>&1 || {
  echo "observability-secrets-setup: sops not found. Run scripts/sops-age-setup first." >&2
  exit 1
}
DAILY_KEY_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/sops/age/keys.txt"
SECRETS_DIR="$REPO_ROOT/workloads/observability/secrets"
mkdir -p "$SECRETS_DIR"

NTFY_FILE="$SECRETS_DIR/ntfy-topic.sops.yaml"
HC_FILE="$SECRETS_DIR/healthchecks-pings.sops.yaml"

# Scratch file for plaintext secret bodies before they're piped through sops;
# must never survive an interrupted run.
plain=""
trap 'rm -f "$plain"' EXIT

# _decrypted FILE — plaintext of an already-encrypted secret file, or empty
# if it doesn't exist or won't decrypt with the daily identity.
_decrypted() {
  [[ -f "$1" ]] || return 1
  SOPS_AGE_KEY_FILE="$DAILY_KEY_FILE" sops -d "$1" 2>/dev/null
}

banner "Observability secrets: ntfy + Healthchecks.io (#169)"

# ── Stage 1: ntfy topic ────────────────────────────────────────────────────
stage "ntfy topic"
say "ntfy needs no signup: the topic string itself is the write credential"
say "(ADR-0018). This wizard generates one for you, no third-party dashboard."

existing=$(_decrypted "$NTFY_FILE" || true)
NTFY_TOPIC=""
if [[ -n "$existing" ]]; then
  NTFY_TOPIC=$(grep -m1 '^\s*NTFY_TOPIC:' <<< "$existing" | sed -E 's/^\s*NTFY_TOPIC:\s*//')
  note "an ntfy topic secret already exists: $NTFY_TOPIC"
  confirm "Regenerate and OVERWRITE it?" && NTFY_TOPIC=""
fi

if [[ -z "$NTFY_TOPIC" ]]; then
  NTFY_TOPIC="homelab-alerts-$(openssl rand -hex 20)"
  # Must sit under secrets/ with a .yaml suffix: .sops.yaml's creation rule
  # (path_regex: secrets/.*\.ya?ml$) is what tells sops which age recipients
  # to encrypt for, and it won't match a bare mktemp path outside secrets/.
  plain="$SECRETS_DIR/.ntfy-topic.plain.yaml"
  cat > "$plain" <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: ntfy-topic
  namespace: observability
stringData:
  NTFY_TOPIC: $NTFY_TOPIC
EOF
  sops --encrypt "$plain" > "$NTFY_FILE"
  rm -f "$plain"
  note "wrote $NTFY_FILE"
fi

say "Subscribe to this exact topic so alerts reach your phone:"
printf '\n  %s%s%s\n\n' "$BOLD" "$NTFY_TOPIC" "$RESET"
step "ntfy app (iOS/Android): Add subscription → paste the topic above."
step "Or in a browser: https://ntfy.sh/$NTFY_TOPIC"
pause "Subscribed?"

# ── Stage 2: Healthchecks.io account + three checks ──────────────────────
stage "Healthchecks.io — create the account and three checks"
say "Free tier: 20 checks, 100 log entries/check (ADR-0018). Three checks:"
say "Watchdog heartbeat, daily PostgreSQL dump, monthly restic check."
open_url "https://healthchecks.io/accounts/signup/"
step "Sign up (or log in if you already have an account)."
open_url "https://healthchecks.io/checks/"
step "Add Check → name it 'homelab-watchdog' → Period 15 minutes, Grace 45"
step "  minutes (ADR-0018's cadence for the Watchdog specifically)."
step "Add Check → name it 'homelab-postgres-dump' → Period 1 day, Grace"
step "  a few hours (covers the daily dump running late, not missing entirely)."
step "Add Check → name it 'homelab-restic-check' → Period 30 days, Grace"
step "  1-2 days (covers the monthly restic check running late)."
pause "All three checks created?"

# ── Stage 3: point each check at the ntfy topic ───────────────────────────
stage "Healthchecks.io — wire each check's ntfy integration"
say "Healthchecks' own alerts (a check going late) need to land on the same"
say "phone topic as Alertmanager's, per ADR-0018's 'one channel' design."
step "For EACH of the three checks: open it → Integrations tab → ntfy →"
step "  Add Integration, topic:"
printf '\n  %s%s%s\n\n' "$BOLD" "$NTFY_TOPIC" "$RESET"
step "  (server: https://ntfy.sh, the default)."
pause "All three checks have the ntfy integration attached?"

# ── Stage 4: capture ping URLs, write + encrypt the secret ───────────────
stage "Capture ping URLs"
say "Each check's detail page shows its ping URL near the top (the one your"
say "backup/restic jobs POST to — a future ticket wires the actual POSTs)."

existing=$(_decrypted "$HC_FILE" || true)
if [[ -n "$existing" ]]; then
  note "a Healthchecks secret already exists."
  if ! confirm "Re-enter and OVERWRITE all three ping URLs?"; then
    WATCHDOG_PING_URL=$(grep -m1 '^\s*WATCHDOG_PING_URL:' <<< "$existing" | sed -E 's/^\s*WATCHDOG_PING_URL:\s*//')
    POSTGRES_DUMP_PING_URL=$(grep -m1 '^\s*POSTGRES_DUMP_PING_URL:' <<< "$existing" | sed -E 's/^\s*POSTGRES_DUMP_PING_URL:\s*//')
    RESTIC_CHECK_PING_URL=$(grep -m1 '^\s*RESTIC_CHECK_PING_URL:' <<< "$existing" | sed -E 's/^\s*RESTIC_CHECK_PING_URL:\s*//')
  fi
fi

[[ -n "${WATCHDOG_PING_URL:-}" ]] || ask_secret WATCHDOG_PING_URL "Paste the homelab-watchdog ping URL:"
[[ -n "${POSTGRES_DUMP_PING_URL:-}" ]] || ask_secret POSTGRES_DUMP_PING_URL "Paste the homelab-postgres-dump ping URL:"
[[ -n "${RESTIC_CHECK_PING_URL:-}" ]] || ask_secret RESTIC_CHECK_PING_URL "Paste the homelab-restic-check ping URL:"

plain="$SECRETS_DIR/.healthchecks-pings.plain.yaml"
cat > "$plain" <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: healthchecks-pings
  namespace: observability
stringData:
  WATCHDOG_PING_URL: $WATCHDOG_PING_URL
  POSTGRES_DUMP_PING_URL: $POSTGRES_DUMP_PING_URL
  RESTIC_CHECK_PING_URL: $RESTIC_CHECK_PING_URL
EOF
sops --encrypt "$plain" > "$HC_FILE"
rm -f "$plain"
note "wrote $HC_FILE"

say "Verifying decryption with the daily identity..."
if _decrypted "$NTFY_FILE" | grep -q '^NTFY_TOPIC:' && _decrypted "$HC_FILE" | grep -q '^WATCHDOG_PING_URL:'; then
  note "✓ both secrets decrypt with the daily identity"
else
  warn "decryption check failed on one of the two secrets"
  exit 1
fi

SKIPPED+=("wiring these into alertmanager-configmap.yaml and scripts/check (#170)")
finish
