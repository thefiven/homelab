#!/usr/bin/env bash
# Import or create ADR-0010's state pool on the disk a serial number
# designates (#116), extracted from role `zfs` so the sequencing bugs
# already found running this against real hardware (unconditional relist,
# hostid-mismatch recognition, the pkname backing-device walk-back) can be
# caught by --self-check instead of by risking the platform's one
# irreplaceable dataset again.
#
# Behaviour is carried over verbatim from the role: `ID_SERIAL` is the one
# discriminant that survives a disk moving slot or enumeration order;
# `/dev/disk/by-id` (never `/dev/nvmeXn1`) is what `zpool` gets, for the
# same reason. Import-before-create is what makes a rerun safe — a pool can
# exist on the disk without being imported (lost cache, moved disk,
# reinstalled system disk), and a bare `zpool create` would happily
# overwrite it. The backing-device check at the end runs unconditionally,
# on every invocation, including when the pool was already imported before
# this script ever ran (e.g. by zfs-import-cache.service at boot) — that is
# the one gap the original role's own comments flagged as still open.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  provision-state-pool --serial SERIAL --pool NAME [-O key=value]...
  provision-state-pool --self-check

  --serial      udev ID_SERIAL of the state disk
  --pool        name of the ZFS pool to import or create
  -O key=value  root-of-pool property, passed verbatim to `zpool create -O`
                (repeatable)
  --self-check  replay import/create logic against fake zpool/udevadm/lsblk/
                readlink executables, no NVMe or ZFS module needed

Env (only meaningful under --self-check; real runs always use the real
/dev/disk/by-id):
  PROVISION_STATE_POOL_BY_ID_DIR  overrides the by-id directory searched
EOF
}

die() { echo "provision-state-pool: $*" >&2; exit 1; }

# Resolves the state pool on the serial-matched disk: imports it if already
# on disk, creates it if the disk is bare, and either way verifies the
# pool's actual backing device is that same disk. Prints the resolved
# by-id path, then a final status line ending in "No change detected" iff
# the pool was already imported before this call — the exact idiom
# k3s/tasks/main.yml's changed_when already keys off, reused rather than
# invented twice.
provision() {
  local serial="$1" pool="$2"
  shift 2
  local -a props=("$@")
  local by_id_dir="${PROVISION_STATE_POOL_BY_ID_DIR:-/dev/disk/by-id}"

  # `eui.*` links name the same disk again under its native NVMe
  # identifier; `-part*` links name a partition, not the whole disk `zpool
  # create` needs to own the partitioning of. Skipping both is what keeps
  # one physical disk from being double-counted or handed to zpool wrong.
  local -a links=()
  local link link_serial
  shopt -s nullglob
  for link in "$by_id_dir"/nvme-*; do
    case "$link" in *eui.*|*-part*) continue ;; esac
    link_serial=$(udevadm info --query=property --name="$link" | sed -n 's/^ID_SERIAL=//p')
    [[ "$link_serial" == "$serial" ]] && links+=("$link")
  done
  shopt -u nullglob
  [[ ${#links[@]} -gt 0 ]] || die "no disk on this host has ID_SERIAL=$serial"

  # Multiple *links* for one disk is normal (one per udev naming
  # convention); what must be unique is the *disk* they resolve to.
  local -a devices=()
  mapfile -t devices < <(readlink -f "${links[@]}" | sort -u)
  [[ ${#devices[@]} -eq 1 ]] || die "$serial designates ${#devices[@]} distinct disks (${devices[*]}); refusing, that serial is not the stable discriminant it's assumed to be"

  local disk="${links[0]}" device="${devices[0]}"

  # Not `mapfile < <(zpool list ...)`: a process substitution's exit status
  # never reaches `mapfile`'s, so `set -e` can't catch a failing `zpool
  # list` here — it would silently read as "pool not imported" and fall
  # into the import/create branch on the strength of an error it never saw.
  local imported_out imported_rc=0
  imported_out=$(zpool list -H -o name) || imported_rc=$?
  [[ $imported_rc -eq 0 ]] || die "zpool list failed: $imported_out"
  local -a imported=()
  [[ -z "$imported_out" ]] || mapfile -t imported <<<"$imported_out"

  local changed=0
  # -F: pool names are compared literally, never as a regex — a serial or
  # pool name containing a metacharacter must not coincidentally match.
  if ! printf '%s\n' "${imported[@]}" | grep -qxF -- "$pool"; then
    local import_out import_rc=0
    import_out=$(LC_ALL=C zpool import -d "$by_id_dir" "$pool" 2>&1) || import_rc=$?
    if [[ $import_rc -eq 0 ]]; then
      changed=1
    elif [[ "$import_out" == *'no such pool available'* ]]; then
      # `-f`: a bare disk can carry a stale non-ZFS signature (an old
      # filesystem, an old partition table) that create would otherwise
      # refuse to write over. Safe here because the branch above already
      # confirmed no importable pool exists — the only thing `-f` can be
      # bypassing is that stale signature, never a live pool.
      zpool create -f -o ashift=12 -o cachefile=/etc/zfs/zpool.cache "${props[@]}" "$pool" "$disk" \
        || die "zpool create failed for $pool on $disk"
      changed=1
    elif [[ "$import_out" == *'pool was previously in use from another system'* ]]; then
      # A reinstalled system disk always leaves a fresh /etc/hostid without
      # touching the state disk's labels, producing exactly this message.
      # `-f` overrides that stale-ownership refusal only; the
      # backing-device check below still catches a same-named pool that
      # turns out to live on the wrong disk, same as every other path.
      local force_out force_rc=0
      force_out=$(LC_ALL=C zpool import -f -d "$by_id_dir" "$pool" 2>&1) || force_rc=$?
      [[ $force_rc -eq 0 ]] || die "force-import failed for $pool after hostid mismatch: $force_out"
      changed=1
    else
      die "zpool import did not report $pool as absent, but also failed to import it: $import_out. Nothing created or force-imported. Diagnose by hand with zpool import -d $by_id_dir"
    fi
  fi

  # Unconditional: a pool already imported before this script ever ran
  # (e.g. zfs-import-cache.service at boot) skips every branch above, with
  # no check yet on which disk it actually came from.
  # `zpool create` on a whole-disk link auto-partitions it (labels live in
  # partition 1), so `zpool status` reports the pool backed by
  # `.../nvme1n1p1`, never the whole-disk path `device` holds — comparing
  # those directly fails every real create. `lsblk -no pkname` walks a
  # partition back to its parent disk; a device with no parent (already a
  # whole disk) falls through to itself unchanged.
  local -a backing=()
  mapfile -t backing < <(
    zpool status -P "$pool" \
      | awk '$1 ~ /^\// { print $1 }' \
      | xargs -r readlink -f \
      | while read -r dev; do
          pkname=$(lsblk -no pkname "$dev" 2>/dev/null)
          if [[ -n "$pkname" ]]; then printf '/dev/%s\n' "$pkname"; else printf '%s\n' "$dev"; fi
        done \
      | sort -u
  )
  [[ ${#backing[@]} -eq 1 && "${backing[0]}" == "$device" ]] \
    || die "pool $pool is backed by ${backing[*]:-<none>}, not the disk resolved from serial $serial ($device); refusing to touch ARC, datasets or trim for a pool that isn't confirmed to live on the serial-matched disk"

  echo "$disk"
  if [[ $changed -eq 1 ]]; then
    echo "provisioned state pool $pool on $disk"
  else
    echo "No change detected: state pool $pool already imported on $disk"
  fi
}

# Fakes zpool/udevadm/lsblk/readlink and replays them through `provision`
# (called directly, in a subshell, never re-exec'd) so the four scenarios
# that matter can run with no NVMe attached: a blank disk, an
# already-importable pool, a hostid-mismatch pool, and a same-named pool
# backed by the wrong disk. A fifth checks the idempotent-rerun contract
# the role's changed_when depends on. `die` inside `provision` exits only
# the subshell it runs in, never self_check itself.
self_check() {
  # Not `local`: a RETURN trap only fires on a normal function return, never
  # on the `exit 1` inside `die` that every failed assertion below takes —
  # this is an EXIT trap instead (build-media's own convention), which can
  # fire after self_check has already returned, so scratch must still be in
  # scope then.
  scratch=$(mktemp -d)
  trap 'rm -rf "$scratch"' EXIT

  local shared="$scratch/shared"
  mkdir -p "$shared"

  cat >"$shared/udevadm" <<'EOF'
#!/usr/bin/env bash
# Fakes `udevadm info --query=property --name=<by-id link>`: the by-id
# filename itself encodes the serial (nvme-<SERIAL>), so no lookup table.
path=""
for arg in "$@"; do
  case "$arg" in --name=*) path="${arg#--name=}" ;; esac
done
echo "ID_SERIAL=$(basename "$path" | sed 's/^nvme-//')"
EOF

  cat >"$shared/readlink" <<'EOF'
#!/usr/bin/env bash
# Fakes `readlink -f`: a by-id link (nvme-<SERIAL>) canonicalizes to a
# fixed fake device path; anything else (already a /dev path) passes
# through unchanged, matching real readlink -f on a non-symlink node.
shift
for p in "$@"; do
  base=$(basename "$p")
  case "$base" in
    nvme-*) echo "/dev/fake-${base#nvme-}" ;;
    *) echo "$p" ;;
  esac
done
EOF

  cat >"$shared/lsblk" <<'EOF'
#!/usr/bin/env bash
# Fakes `lsblk -no pkname <partition>`: strips a trailing pN, the same
# shape as the real command walking a partition back to its parent disk.
dev="${*: -1}"
basename "$dev" | sed -E 's/p[0-9]+$//'
EOF
  chmod +x "$shared"/udevadm "$shared"/readlink "$shared"/lsblk

  # $1 by-id dir, $2 serial. Seeds the matching link plus the -part/eui
  # siblings the real script must exclude, not just happen to skip.
  seed_by_id() {
    mkdir -p "$1"
    : >"$1/nvme-$2"
    : >"$1/nvme-$2-part1"
    : >"$1/nvme-$2_eui.0000000000000001"
  }

  run_provision() {
    local zpool_dir="$1" by_id_dir="$2" serial="$3" pool="$4"
    ( PATH="$zpool_dir:$shared:$PATH" PROVISION_STATE_POOL_BY_ID_DIR="$by_id_dir" \
        provision "$serial" "$pool" -O atime=on ) 2>&1
  }

  local pool=state out rc dir byid

  # 1. Blank disk: no pool anywhere -> create.
  dir="$scratch/s1/zpool"; byid="$scratch/s1/byid"; mkdir -p "$dir"
  seed_by_id "$byid" BLANK1
  cat >"$dir/zpool" <<'EOF'
#!/usr/bin/env bash
case "$1" in
  list) : ;;
  import) echo "cannot import 'state': no such pool available" >&2; exit 1 ;;
  create) exit 0 ;;
  status) echo "  /dev/fake-BLANK1p1 ONLINE" ;;
  *) echo "unhandled: $*" >&2; exit 9 ;;
esac
EOF
  chmod +x "$dir/zpool"
  rc=0; out=$(run_provision "$dir" "$byid" BLANK1 "$pool") || rc=$?
  [[ $rc -eq 0 ]] || die "self-check: blank-disk scenario should succeed, got rc=$rc: $out"
  [[ "$out" == *'nvme-BLANK1'* ]] || die "self-check: blank-disk scenario didn't resolve the disk it should create on"
  [[ "$out" != *'No change detected'* ]] || die "self-check: blank-disk scenario should report a change"

  # 2. Already-importable pool -> plain import, no force, no create.
  dir="$scratch/s2/zpool"; byid="$scratch/s2/byid"; mkdir -p "$dir"
  seed_by_id "$byid" IMPORTABLE2
  cat >"$dir/zpool" <<'EOF'
#!/usr/bin/env bash
case "$1" in
  list) : ;;
  import)
    for a in "$@"; do [[ "$a" == "-f" ]] && { echo "unexpected forced import" >&2; exit 9; }; done
    exit 0 ;;
  create) echo "unexpected create" >&2; exit 9 ;;
  status) echo "  /dev/fake-IMPORTABLE2p1 ONLINE" ;;
  *) echo "unhandled: $*" >&2; exit 9 ;;
esac
EOF
  chmod +x "$dir/zpool"
  rc=0; out=$(run_provision "$dir" "$byid" IMPORTABLE2 "$pool") || rc=$?
  [[ $rc -eq 0 ]] || die "self-check: importable-pool scenario should succeed, got rc=$rc: $out"
  [[ "$out" != *'No change detected'* ]] || die "self-check: importable-pool scenario should report a change"

  # 3. Hostid mismatch -> force-import, no create.
  dir="$scratch/s3/zpool"; byid="$scratch/s3/byid"; mkdir -p "$dir"
  seed_by_id "$byid" HOSTID3
  cat >"$dir/zpool" <<'EOF'
#!/usr/bin/env bash
case "$1" in
  list) : ;;
  import)
    force=0
    for a in "$@"; do [[ "$a" == "-f" ]] && force=1; done
    if [[ $force -eq 1 ]]; then
      exit 0
    else
      echo "cannot import 'state': pool was previously in use from another system" >&2
      exit 1
    fi ;;
  create) echo "unexpected create" >&2; exit 9 ;;
  status) echo "  /dev/fake-HOSTID3p1 ONLINE" ;;
  *) echo "unhandled: $*" >&2; exit 9 ;;
esac
EOF
  chmod +x "$dir/zpool"
  rc=0; out=$(run_provision "$dir" "$byid" HOSTID3 "$pool") || rc=$?
  [[ $rc -eq 0 ]] || die "self-check: hostid-mismatch scenario should succeed, got rc=$rc: $out"
  [[ "$out" != *'No change detected'* ]] || die "self-check: hostid-mismatch scenario should report a change"

  # 4. Same-named pool backed by a different disk than the serial matched
  #    -> must refuse. Both create and force-import die if hit, so a
  #    zero exit here would mean a mutation was attempted, not just missed.
  dir="$scratch/s4/zpool"; byid="$scratch/s4/byid"; mkdir -p "$dir"
  seed_by_id "$byid" RIGHT4
  cat >"$dir/zpool" <<'EOF'
#!/usr/bin/env bash
case "$1" in
  list) : ;;
  import)
    for a in "$@"; do [[ "$a" == "-f" ]] && { echo "unexpected forced import" >&2; exit 9; }; done
    exit 0 ;;
  create) echo "unexpected create" >&2; exit 9 ;;
  status) echo "  /dev/fake-WRONG4p1 ONLINE" ;;
  *) echo "unhandled: $*" >&2; exit 9 ;;
esac
EOF
  chmod +x "$dir/zpool"
  rc=0; out=$(run_provision "$dir" "$byid" RIGHT4 "$pool") || rc=$?
  [[ $rc -ne 0 ]] || die "self-check: wrong-backing-disk scenario should refuse, but exited 0: $out"

  # 5. Idempotent rerun: pool already imported before the script starts ->
  #    no import/force/create call at all, changed_when contract holds.
  dir="$scratch/s5/zpool"; byid="$scratch/s5/byid"; mkdir -p "$dir"
  seed_by_id "$byid" ALREADY5
  cat >"$dir/zpool" <<'EOF'
#!/usr/bin/env bash
case "$1" in
  list) echo state ;;
  import) echo "unexpected import" >&2; exit 9 ;;
  create) echo "unexpected create" >&2; exit 9 ;;
  status) echo "  /dev/fake-ALREADY5p1 ONLINE" ;;
  *) echo "unhandled: $*" >&2; exit 9 ;;
esac
EOF
  chmod +x "$dir/zpool"
  rc=0; out=$(run_provision "$dir" "$byid" ALREADY5 "$pool") || rc=$?
  [[ $rc -eq 0 ]] || die "self-check: idempotent-rerun scenario should succeed, got rc=$rc: $out"
  [[ "$out" == *'No change detected'* ]] || die "self-check: idempotent rerun must report no change (changed_when contract)"

  echo "self-check: passed"
}

serial='' pool='' self_check_mode=0
declare -a props=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --serial) serial="$2"; shift 2 ;;
    --pool) pool="$2"; shift 2 ;;
    -O) props+=(-O "$2"); shift 2 ;;
    --self-check) self_check_mode=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

if [[ "$self_check_mode" -eq 1 ]]; then
  self_check
  exit 0
fi

[[ -n "$serial" && -n "$pool" ]] || { usage; die "--serial and --pool are both required"; }

provision "$serial" "$pool" "${props[@]}"
