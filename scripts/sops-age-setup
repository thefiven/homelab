#!/usr/bin/env bash
#
# A wizard — walks a human through a manual procedure step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library — delightful, consistent UX. Identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear — wipe the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" — opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later — it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" — clear the screen, then announce a stage and show progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." — a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." — a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL — open in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser — visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser — visit it manually: $url"
}

# pause "msg" — wait for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" — y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY — current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" — read a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" — like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE — upsert KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE — set a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name — gh not ready; set it later"
}

# set_var NAME VALUE — set a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name — gh not ready; set it later"
}

# finish — clear, then a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: SOPS + age setup (ADR-0009, #72).
#
# Generates the two age identities the ADR calls for, writes .sops.yaml with
# both public keys, and proves the daily identity can decrypt with a test
# secret. The recovery private key is shown once, for you to paste into
# Google Password Manager, then deleted from disk; it must never live as a
# file outside that step. The kubectl step that loads the daily identity
# into a cluster is deliberately NOT run here (no cluster exists yet); it's
# the `gitops` role's own task (#115), run later once Flux is up.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=5

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "sops-age-setup: run this from inside the homelab git checkout" >&2
  exit 1
}
SOPS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sops/age"
DAILY_KEY_FILE="$SOPS_DIR/keys.txt"

# Temp files/dirs that must never survive an interrupted run (they hold, or
# will hold, the recovery private key / a plaintext secret / a download
# scratch dir). Cleaned on any exit.
recovery_tmp=""
plain=""
tmp_dir=""
trap 'rm -rf "$tmp_dir" 2>/dev/null; rm -f "$recovery_tmp" "$plain" 2>/dev/null' EXIT

banner "SOPS + age setup (#72)"

# ── Stage 1: install age + sops ────────────────────────────────────────────
stage "Install age and sops"
say "ADR-0009 picks SOPS+age over GPG/Vault/KMS. Both need to be on PATH."

if command -v age-keygen >/dev/null 2>&1; then
  note "age already installed"
else
  step "age is in Ubuntu's universe repo; installing needs sudo."
  if confirm "Run 'sudo apt-get install -y age'?"; then
    sudo apt-get install -y age
  else
    echo "sops-age-setup: age is required from here on; install it and re-run." >&2
    exit 1
  fi
fi

if command -v sops >/dev/null 2>&1; then
  note "sops already installed"
else
  step "sops isn't packaged for apt; fetching the checksum-verified binary from GitHub releases."
  case "$(uname -m)" in
    x86_64)  sops_arch=amd64 ;;
    aarch64) sops_arch=arm64 ;;
    *) echo "sops-age-setup: unrecognised architecture $(uname -m); install sops manually: https://github.com/getsops/sops/releases" >&2
       exit 1 ;;
  esac
  # Capture the full response first: grep -m1 closes its end of the pipe as
  # soon as it matches, and anything still writing into that pipe (curl, or
  # even printf) gets SIGPIPE, which pipefail/errexit then aborts the whole
  # script on. A here-string has no writer process to kill.
  releases_json=$(curl -sSf https://api.github.com/repos/getsops/sops/releases/latest)
  tag=$(grep -m1 '"tag_name"' <<< "$releases_json" | sed -E 's/.*"([^"]+)".*/\1/')
  bin="sops-${tag}.linux.${sops_arch}"
  # Under $HOME, not /tmp: the sops binary is ~50MB and some systems cap
  # /tmp (tmpfs with a user quota) well under that.
  tmp_dir=$(mktemp -d "$HOME/.sops-age-setup.XXXXXX")
  curl -sSfL --retry 3 --retry-delay 2 -o "$tmp_dir/$bin" "https://github.com/getsops/sops/releases/download/${tag}/${bin}"
  curl -sSfL --retry 3 --retry-delay 2 -o "$tmp_dir/checksums.txt" "https://github.com/getsops/sops/releases/download/${tag}/sops-${tag}.checksums.txt"
  (cd "$tmp_dir" && grep " ${bin}\$" checksums.txt | sha256sum -c -)
  mkdir -p "$HOME/.local/bin"
  install -m 0755 "$tmp_dir/$bin" "$HOME/.local/bin/sops"
  rm -rf "$tmp_dir"
  export PATH="$HOME/.local/bin:$PATH"
  note "installed sops ${tag} to $HOME/.local/bin/sops"
fi

command -v age-keygen >/dev/null 2>&1 || { echo "sops-age-setup: age-keygen still not found." >&2; exit 1; }
command -v sops >/dev/null 2>&1 || { echo "sops-age-setup: sops still not found." >&2; exit 1; }

# ── Stage 2: daily identity ────────────────────────────────────────────────
stage "Daily identity"
say "Kept as a local file only. Loaded into the cluster later by the gitops role."
mkdir -p "$SOPS_DIR"
chmod 700 "$SOPS_DIR"
if [[ -f "$DAILY_KEY_FILE" ]]; then
  note "daily identity already exists at $DAILY_KEY_FILE"
  # age-keygen refuses to write to a file that already exists, so an
  # overwrite needs the old one gone first.
  confirm "Regenerate and OVERWRITE it?" && rm -f "$DAILY_KEY_FILE" && age-keygen -o "$DAILY_KEY_FILE"
else
  age-keygen -o "$DAILY_KEY_FILE"
fi
chmod 600 "$DAILY_KEY_FILE"
DAILY_PUBLIC_KEY=$(age-keygen -y "$DAILY_KEY_FILE")
note "daily public key:  $DAILY_PUBLIC_KEY"
note "daily private key: $DAILY_KEY_FILE (never committed, never leaves this machine)"

# ── Stage 3: recovery identity → Google Password Manager ──────────────────
stage "Recovery identity → Google Password Manager"
say "Per ADR-0009 its private key lives ONLY in Google Password Manager, never as a file on disk after this stage."
# mktemp -u: age-keygen refuses to write to a file that already exists, so
# the path must not exist yet when it runs.
# ponytail: mktemp -u has a TOCTOU race; acceptable on a single-operator
# workstation with no local attacker model.
recovery_tmp=$(mktemp -u)
age-keygen -o "$recovery_tmp"
RECOVERY_PUBLIC_KEY=$(age-keygen -y "$recovery_tmp")
RECOVERY_PRIVATE_KEY=$(grep '^AGE-SECRET-KEY-' "$recovery_tmp")
open_url "https://passwords.google.com/"
step "Add a new password entry titled e.g. 'homelab sops-age recovery identity'."
step "Paste this private key into its Notes field, then save:"
printf '\n  %s%s%s\n\n' "$BOLD" "$RECOVERY_PRIVATE_KEY" "$RESET"
note "public key (not secret, safe to keep here): $RECOVERY_PUBLIC_KEY"
until confirm "Saved as a note in Google Password Manager? (N shows the key again)"; do
  printf '\n  %s%s%s\n\n' "$BOLD" "$RECOVERY_PRIVATE_KEY" "$RESET"
done
if command -v shred >/dev/null 2>&1; then shred -u "$recovery_tmp"; else rm -f "$recovery_tmp"; fi
note "local copy of the recovery private key deleted."

# ── Stage 4: .sops.yaml ────────────────────────────────────────────────────
stage "Write .sops.yaml"
say "Both public keys as recipients, scoped to secrets/, encrypting only Secret payloads (ADR-0009)."
cat > "$REPO_ROOT/.sops.yaml" <<EOF
# Recipients for both age identities (ADR-0009): daily (local file, loaded
# into the cluster by the \`gitops\` role, #115) and recovery (private key
# in Google Password Manager, never loaded into the cluster in normal use).
# Regenerated by scripts/sops-age-setup; a changed key list needs a
# tree-wide \`sops updatekeys\` pass afterwards.
creation_rules:
  - path_regex: secrets/.*\.ya?ml\$
    encrypted_regex: ^(data|stringData)\$
    age: >-
      ${DAILY_PUBLIC_KEY},
      ${RECOVERY_PUBLIC_KEY}
EOF
note "wrote $REPO_ROOT/.sops.yaml"

# ── Stage 5: test encrypted secret ─────────────────────────────────────────
stage "Test encrypted secret"
mkdir -p "$REPO_ROOT/secrets"
plain="$REPO_ROOT/secrets/test-secret.yaml"
encrypted="$REPO_ROOT/secrets/test-secret.sops.yaml"
cat > "$plain" <<'EOF'
apiVersion: v1
kind: Secret
metadata:
  name: sops-age-smoke-test
  namespace: default
stringData:
  ping: pong
EOF
sops --encrypt "$plain" > "$encrypted"
rm -f "$plain"
note "wrote $encrypted"

say "Verifying decryption with the daily identity..."
decrypted=$(SOPS_AGE_KEY_FILE="$DAILY_KEY_FILE" sops -d "$encrypted")
if [[ "$decrypted" == *"ping: pong"* ]]; then
  note "✓ sops -d decrypts the test secret with the daily identity"
else
  warn "sops -d did NOT decrypt the test secret as expected"
  exit 1
fi

SKIPPED+=("cluster bootstrap: the gitops role's sops-age task (run once Flux/k3s exists, per ADR-0009's deferral)")
finish
