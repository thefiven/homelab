#!/usr/bin/env bash
# Stamp a stock Ubuntu Server ISO into zero-touch autoinstall media for one
# node (ADR-0013, gesture 3). Embeds a cloud-init NoCloud user-data/meta-data
# pair (storage.layout.match.serial disambiguates the target disk; the
# bootstrap account is a locked-password, key-only, NOPASSWD-sudo user via
# user-data.users, never `identity`) and patches boot/grub/grub.cfg +
# loopback.cfg so install starts on insert + power-on, no console needed.
#
# ponytail: the grub.cfg patch matches the ` ---` cmdline-separator
# convention casper installer menus have used across releases, verified via
# community autoinstall-ISO tooling and Canonical's own zero-touch docs, but
# not against an actual Ubuntu Server 26.04 ISO (unavailable at authoring
# time). First real run should confirm the patched entry boots, before this
# node's stick is trusted; that hands-on check is the ready-for-human half
# of this ticket.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  build-media --serial SERIAL --ssh-key KEY_OR_PATH --hostname HOSTNAME \
              --iso STOCK.iso --output STAMPED.iso
  build-media --self-check

  --serial     udev ID_SERIAL of the target disk (storage.layout.match.serial)
  --ssh-key    SSH public key, literal or a path to a .pub file
  --hostname   node hostname (single label)
  --iso        path to a stock Ubuntu Server ISO
  --output     path to write the stamped ISO
  --self-check verify config generation against sample input, no ISO/xorriso needed
EOF
}

die() { echo "build-media: $*" >&2; exit 1; }

# Escapes a value for embedding in a double-quoted YAML scalar.
yaml_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

validate_hostname() {
  [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] \
    || die "invalid hostname: $1"
}

validate_serial() {
  [[ "$1" =~ ^[A-Za-z0-9_.:-]+$ ]] || die "invalid serial: $1"
}

validate_pubkey() {
  # Reject embedded newlines first: [[:space:]] in the trailing-comment group
  # below matches a newline too, so a two-line value (e.g. --ssh-key
  # "$(cat file.pub)" against a file with a trailing blank line) would
  # otherwise pass and get YAML-folded into one corrupted authorized_keys
  # entry — fatal here since the bootstrap account is key-only, no fallback.
  [[ "$1" != *$'\n'* ]] || die "SSH public key must be a single line: $1"
  # authorized_keys line: "<type> <base64> [comment]", type is a known prefix.
  [[ "$1" =~ ^(ssh-ed25519|ssh-rsa|ecdsa-sha2-[a-z0-9-]+)[[:space:]]+[A-Za-z0-9+/=]+([[:space:]].*)?$ ]] \
    || die "invalid SSH public key: $1"
}

resolve_pubkey() {
  # A readable file wins; otherwise treat the argument as literal key content.
  if [[ -f "$1" ]]; then
    head -n1 "$1"
  else
    printf '%s' "$1"
  fi
}

render_user_data() {
  local serial pubkey hostname
  serial=$(yaml_escape "$1") pubkey=$(yaml_escape "$2") hostname=$(yaml_escape "$3")
  cat <<EOF
#cloud-config
autoinstall:
  version: 1
  ssh:
    install-server: true
    allow-pw: false
  storage:
    layout:
      name: direct
      match:
        serial: "$serial"
  user-data:
    hostname: "$hostname"
    users:
      - name: ubuntu
        lock_passwd: true
        sudo: "ALL=(ALL) NOPASSWD:ALL"
        ssh_authorized_keys:
          - "$pubkey"
EOF
}

render_meta_data() {
  local hostname
  hostname=$(yaml_escape "$1")
  cat <<EOF
instance-id: "$hostname"
local-hostname: "$hostname"
EOF
}

# Patches a grub.cfg/loopback.cfg boot entry (read on stdin, written on
# stdout) so it boots straight into unattended autoinstall: the bare
# `autoinstall` word skips the "Continue with autoinstall?" console prompt,
# `ds=nocloud;s=/cdrom/nocloud/` points cloud-init at the embedded pair.
# The trailing backslash before `;` is a GRUB escape, not a shell one.
patch_grub_cfg() {
  sed -E 's# ---# autoinstall ds=nocloud\\;s=/cdrom/nocloud/ ---#g'
}

self_check() {
  local out serial=SAMPLE_SERIAL_123 hostname=node2
  local pubkey='ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIsample test@example'

  out=$(render_user_data "$serial" "$pubkey" "$hostname")
  [[ "$out" == *'serial: "SAMPLE_SERIAL_123"'* ]] || die "self-check: serial not substituted into storage.layout.match.serial"
  [[ "$out" == *'hostname: "node2"'* ]] || die "self-check: hostname not substituted"
  [[ "$out" == *"$pubkey"* ]] || die "self-check: pubkey not substituted"
  [[ "$out" == *'lock_passwd: true'* && "$out" == *'NOPASSWD:ALL'* ]] || die "self-check: bootstrap account shape missing"
  [[ "$out" != *'identity:'* ]] || die "self-check: identity: section must not be emitted (ADR-0013)"

  out=$(render_meta_data "$hostname")
  [[ "$out" == *'instance-id: "node2"'* && "$out" == *'local-hostname: "node2"'* ]] \
    || die "self-check: meta-data hostname not substituted"

  out=$(printf 'linux\t/casper/vmlinuz quiet ---\ninitrd\t/casper/initrd\n' | patch_grub_cfg)
  [[ "$out" == *' autoinstall ds=nocloud\;s=/cdrom/nocloud/ ---'* ]] \
    || die "self-check: kernel cmdline not patched"

  # A quote in operator-supplied input must not break the generated YAML.
  out=$(render_user_data 'evil"serial' "$pubkey" "$hostname")
  [[ "$out" == *'serial: "evil\"serial"'* ]] || die "self-check: quote in serial not escaped"

  echo "self-check: passed"
}

build() {
  local serial="$1" pubkey="$2" hostname="$3" iso="$4" output="$5"
  command -v xorriso >/dev/null || die "xorriso is required (apt install xorriso)"
  [[ -f "$iso" ]] || die "no such ISO: $iso"
  # xorriso's own collision handling for a pre-existing -outdev is untested
  # here; refuse up front rather than risk a hang or opaque error.
  [[ ! -e "$output" ]] || die "output already exists: $output (remove it first)"

  # Not `local`: the EXIT trap runs after this function returns, and would
  # see an unbound variable under `set -u` if tmp's scope ended with it.
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT

  render_user_data "$serial" "$pubkey" "$hostname" >"$tmp/user-data"
  render_meta_data "$hostname" >"$tmp/meta-data"

  xorriso -indev "$iso" -osirrox on -extract /boot/grub/grub.cfg "$tmp/grub.cfg"
  patch_grub_cfg <"$tmp/grub.cfg" >"$tmp/grub.cfg.patched"

  local -a xorriso_args=(
    -indev "$iso" -outdev "$output"
    -boot_image any replay
    -update "$tmp/grub.cfg.patched" /boot/grub/grub.cfg
    -mkdir /nocloud
    -update "$tmp/user-data" /nocloud/user-data
    -update "$tmp/meta-data" /nocloud/meta-data
  )
  # loopback.cfg (BIOS boot menu) is optional across releases; patch it too
  # when present so a non-UEFI boot is also unattended. Any extraction
  # failure (absent file, or a real error — xorriso's stderr still prints)
  # is treated the same: skip it, but say so, since a silent skip here means
  # a BIOS boot falls back to the console prompt this script exists to avoid.
  if xorriso -indev "$iso" -osirrox on -extract /boot/grub/loopback.cfg "$tmp/loopback.cfg"; then
    patch_grub_cfg <"$tmp/loopback.cfg" >"$tmp/loopback.cfg.patched"
    xorriso_args+=(-update "$tmp/loopback.cfg.patched" /boot/grub/loopback.cfg)
  else
    echo "build-media: warning: could not extract boot/grub/loopback.cfg, leaving it unpatched (BIOS boot may show the confirmation prompt)" >&2
  fi

  xorriso "${xorriso_args[@]}"
  echo "wrote $output"
}

serial= pubkey_arg= hostname= iso= output= self_check_mode=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --serial) serial="$2"; shift 2 ;;
    --ssh-key) pubkey_arg="$2"; shift 2 ;;
    --hostname) hostname="$2"; shift 2 ;;
    --iso) iso="$2"; shift 2 ;;
    --output) output="$2"; shift 2 ;;
    --self-check) self_check_mode=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

if [[ "$self_check_mode" -eq 1 ]]; then
  self_check
  exit 0
fi

[[ -n "$serial" && -n "$pubkey_arg" && -n "$hostname" && -n "$iso" && -n "$output" ]] \
  || { usage; die "--serial, --ssh-key, --hostname, --iso and --output are all required"; }

pubkey=$(resolve_pubkey "$pubkey_arg")
validate_serial "$serial"
validate_pubkey "$pubkey"
validate_hostname "$hostname"

build "$serial" "$pubkey" "$hostname" "$iso" "$output"
