#!/usr/bin/env bash
#
# A wizard — walks a human through a manual procedure step by step.
# Generated by the /wizard skill.
#
# Sources the shared wizard library (scripts/lib/wizard.sh); do not hand-edit
# a wizard's inlined copy of it. After a /wizard regeneration inlines the
# library back in, replace it with this source line before committing.

# shellcheck source=lib/wizard.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/wizard.sh"

# ──────────────────────────────────────────────────────────────────────────
# STAGES: ingress secrets (#179, ADR-0011).
#
# Produces two SOPS+age-encrypted Kubernetes Secrets:
#
#   workloads/ingress/secrets/cloudflare-api-token.sops.yaml
#     kube-system/cloudflare-api-token, key CF_DNS_API_TOKEN: the scoped
#     token Traefik's built-in ACME resolver reads for the Cloudflare DNS-01
#     challenge. Name/namespace/key are already fixed by the `k3s` role
#     (ansible/roles/k3s/defaults/main.yml, #178) which wired the
#     secretKeyRef before this secret existed; namespace is kube-system, not
#     ingress, because that's where k3s's bundled Traefik pod actually runs.
#
#   workloads/ingress/secrets/cloudflare-tunnel-token.sops.yaml
#     ingress/cloudflare-tunnel-token, key TUNNEL_TOKEN: the token for a
#     remotely-managed Cloudflare Tunnel, the env var cloudflared itself
#     reads when run with no config file or credentials.json
#     (developers.cloudflare.com/cloudflare-one/networks/connectors/
#     cloudflare-tunnel/deployment-guides/kubernetes/). No consumer yet:
#     #180 (162-03) adds the cloudflared Deployment that reads it.
#
# Neither file is wired into workloads/ingress/kustomization.yaml by this
# wizard: that resources entry is added once these files exist (same
# two-step order workloads/observability's ntfy/Healthchecks secrets
# followed: scripts/observability-secrets-setup shipped first, a later
# commit ran it and wired the result in).
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=3

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "ingress-secrets-setup: run this from inside the homelab git checkout" >&2
  exit 1
}
command -v sops >/dev/null 2>&1 || {
  echo "ingress-secrets-setup: sops not found. Run scripts/sops-age-setup first." >&2
  exit 1
}
DAILY_KEY_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/sops/age/keys.txt"
SECRETS_DIR="$REPO_ROOT/workloads/ingress/secrets"
mkdir -p "$SECRETS_DIR"

API_TOKEN_FILE="$SECRETS_DIR/cloudflare-api-token.sops.yaml"
TUNNEL_TOKEN_FILE="$SECRETS_DIR/cloudflare-tunnel-token.sops.yaml"

# Scratch file for plaintext secret bodies before they're piped through sops;
# must never survive an interrupted run.
plain=""
trap 'rm -f "$plain"' EXIT

# _decrypted FILE — plaintext of an already-encrypted secret file, or empty
# if it doesn't exist or won't decrypt with the daily identity.
_decrypted() {
  [[ -f "$1" ]] || return 1
  SOPS_AGE_KEY_FILE="$DAILY_KEY_FILE" sops -d "$1" 2>/dev/null
}

# _needs_write FILE LABEL: true if FILE doesn't already decrypt (nothing to
# keep) or the human confirms overwriting what's there. One shared gate for
# both secrets below, so the confirm-direction only has to be right once.
_needs_write() {
  local existing
  existing=$(_decrypted "$1" || true)
  [[ -z "$existing" ]] && return 0
  note "a $2 secret already exists."
  confirm "Regenerate and OVERWRITE it?"
}

banner "Ingress secrets: Cloudflare API token + Tunnel token (#179)"

# ── Stage 1: the domain must already be a Cloudflare zone ────────────────
stage "Domain in Cloudflare"
say "Both secrets below are scoped to one Cloudflare zone (ADR-0011's"
say "wildcard-cert domain). Neither is buyable or addable by this wizard."
open_url "https://dash.cloudflare.com/"
step "Add the domain as a site if it isn't one already (Add a site → follow"
step "  Cloudflare's nameserver-change instructions with your registrar)."
ask DOMAIN "Domain (e.g. example.com):"
say "This wizard doesn't write $DOMAIN anywhere in the repo, set"
say "k3s_traefik_domain and k3s_traefik_acme_email in node1's host_vars"
say "yourself once it's active (ansible/roles/k3s/defaults/main.yml, #178)."
pause "Zone active in Cloudflare (nameservers propagated)?"

# ── Stage 2: scoped API token for the DNS-01 solver ───────────────────────
stage "Cloudflare API token (DNS-01 solver)"
say "Traefik's ACME resolver needs Zone:DNS:Edit to create the challenge"
say "record, and Zone:Zone:Read to resolve $DOMAIN to a Zone ID first"
say "(lego's Cloudflare provider looks it up before it can edit anything,"
say "a DNS:Edit-only token fails at that lookup step, not the edit step)."

if _needs_write "$API_TOKEN_FILE" "Cloudflare API token"; then
  open_url "https://dash.cloudflare.com/profile/api-tokens"
  step "Create Token → Custom Token."
  step "Permissions: Zone / DNS / Edit, and Zone / Zone / Read."
  step "Zone Resources: Include / Specific zone / $DOMAIN."
  step "Continue to summary → Create Token → copy the token (shown once)."
  ask_secret CF_DNS_API_TOKEN "Paste the Cloudflare API token:"

  plain="$SECRETS_DIR/.cloudflare-api-token.plain.yaml"
  cat > "$plain" <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-token
  namespace: kube-system
stringData:
  CF_DNS_API_TOKEN: $CF_DNS_API_TOKEN
EOF
  sops --encrypt "$plain" > "$API_TOKEN_FILE"
  rm -f "$plain"
  note "wrote $API_TOKEN_FILE"
fi

# ── Stage 3: Cloudflare Tunnel token ──────────────────────────────────────
stage "Cloudflare Tunnel token"
say "A remotely-managed Tunnel: cloudflared in the cluster only needs this"
say "one token (env var TUNNEL_TOKEN) to connect out, no credentials.json or"
say "config.yaml. Routing to a public hostname is a later ticket's job."

if _needs_write "$TUNNEL_TOKEN_FILE" "Cloudflare Tunnel token"; then
  open_url "https://one.dash.cloudflare.com/"
  step "Networks → Tunnels → Create a tunnel → Cloudflared connector."
  step "Name it (e.g. homelab-node1) → Save tunnel."
  step "On the connector install step, pick Docker and copy JUST the token"
  step "  value (the long string after --token), not the whole command."
  ask_secret TUNNEL_TOKEN "Paste the Tunnel token:"

  plain="$SECRETS_DIR/.cloudflare-tunnel-token.plain.yaml"
  cat > "$plain" <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-tunnel-token
  namespace: ingress
stringData:
  TUNNEL_TOKEN: $TUNNEL_TOKEN
EOF
  sops --encrypt "$plain" > "$TUNNEL_TOKEN_FILE"
  rm -f "$plain"
  note "wrote $TUNNEL_TOKEN_FILE"
fi

say "Verifying decryption with the daily identity..."
if _decrypted "$API_TOKEN_FILE" | grep -q '^\s*CF_DNS_API_TOKEN:' \
  && _decrypted "$TUNNEL_TOKEN_FILE" | grep -q '^\s*TUNNEL_TOKEN:'; then
  note "✓ both secrets decrypt with the daily identity"
else
  warn "decryption check failed on one of the two secrets"
  exit 1
fi

SKIPPED+=("setting k3s_traefik_domain/k3s_traefik_acme_email in node1's host_vars (#178)")
SKIPPED+=("adding both secrets to workloads/ingress/kustomization.yaml's resources")
SKIPPED+=("the cloudflared Deployment that reads TUNNEL_TOKEN (#180)")
SKIPPED+=("routing a public hostname to the Tunnel (#181)")
finish
