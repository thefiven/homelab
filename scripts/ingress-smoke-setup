#!/usr/bin/env bash
#
# A wizard — walks a human through a manual procedure step by step.
# Generated by the /wizard skill.
#
# Sources the shared wizard library (scripts/lib/wizard.sh); do not hand-edit
# a wizard's inlined copy of it. After a /wizard regeneration inlines the
# library back in, replace it with this source line before committing.

# shellcheck source=lib/wizard.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/wizard.sh"

# ──────────────────────────────────────────────────────────────────────────
# STAGES: smoke hostname (#181/162-04, ADR-0011).
#
# Cloudflare Tunnel is remotely-managed (#180): its public-hostname-to-origin
# routing lives in the dashboard, not a config.yaml in this repo, so it's a
# human-only step no wizard can skip. Everything this ticket could commit
# instead - the smoke backend and its catch-all Ingress - already landed as
# workloads/smoke/{deployment,service,ingress}.yaml in the same change; this
# wizard only covers the dashboard half and verifies the result.
#
# Writes nothing to the repo (same as #179's DOMAIN prompt): the throwaway
# hostname is a Cloudflare dashboard setting, not repo config.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=3

banner "Ingress smoke test: public hostname (#181)"

# ── Stage 1: the tunnel from #179 must already exist ──────────────────────
stage "Cloudflare Tunnel exists"
say "This reuses the Tunnel scripts/ingress-secrets-setup (#179) created and"
say "captured a TUNNEL_TOKEN for, not a new one."
open_url "https://one.dash.cloudflare.com/"
step "Networks → Tunnels → confirm the tunnel from #179 (e.g. homelab-node1)"
step "  is listed. If it isn't, run scripts/ingress-secrets-setup first."
pause "Tunnel visible in the dashboard?"

# ── Stage 2: route a throwaway hostname to Traefik ─────────────────────────
stage "Public Hostname → Traefik"
say "Adds a route on that same tunnel: the throwaway hostname → Traefik's"
say "in-cluster Service, over HTTPS so this also exercises Traefik's own"
say "ACME wildcard cert (#178), not just tunnel connectivity."
say "workloads/smoke/ingress.yaml (this change) is a catch-all - it has no"
say "host of its own to match, so any hostname routed here reaches it."
ask SUBDOMAIN "Throwaway subdomain to use (e.g. smoke):"
step "On the tunnel → Public Hostname tab → Add a public hostname."
step "  Subdomain: $SUBDOMAIN   Domain: the zone from #179's wizard."
step "  Service → Type: HTTPS   URL: traefik.kube-system.svc.cluster.local:443"
step "Save hostname."
say "This won't resolve yet if k3s_traefik_domain/k3s_traefik_acme_email"
say "aren't set in node1's host_vars (#178) or this branch isn't deployed -"
say "both may still be pending. Re-run this stage once they land."
pause "Public hostname saved?"

# ── Stage 3: verify end to end ─────────────────────────────────────────────
stage "Verify"
say "Expect traefik/whoami's plaintext response (Hostname/IP/headers) over a"
say "valid TLS connection - proof Cloudflare Tunnel → Traefik → the smoke"
say "pod works, and that Traefik's own wildcard cert was actually issued"
say "(ADR-0011 user stories 1, 2, 4, 7), not just that the Deployment runs."
step "curl -sSI https://$SUBDOMAIN.<domain>/  (expect HTTP/2 200, valid cert)"
step "Open the same URL in a browser: body names Hostname: smoke-whoami-..."
if confirm "Did it come back clean (200, real cert, whoami's body)?"; then
  note "✓ Cloudflare Tunnel → Traefik → wildcard cert verified end to end"
else
  warn "not verified yet - re-run this wizard once the pending pieces land"
fi

SKIPPED+=("deciding whether smoke-whoami is a permanent canary or gets torn down later (#162, implementer's call)")
finish
