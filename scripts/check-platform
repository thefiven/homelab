#!/usr/bin/env bash
# Asserts the platform invariants #101 exists to prepare and #102 exists to
# prove — the same list docs/reference/platform-state.md describes in
# prose, kept in sync with this script's checks. Runs on node1 over SSH
# (NODE1_HOST overrides the "node1" SSH-config alias, same convention as
# scripts/sops-age-bootstrap): every check here is either node-local (ZFS,
# mounts, pending reboot) or answered by node1's own k3s kubectl, so
# there's nothing a local kubectl/kubeconfig would add.
#
# Exits non-zero on the first failing check; its name is the last line
# printed before that (set -e over the remote script).
set -euo pipefail

node1_host="${NODE1_HOST:-node1}"

# Read the NAS check's shape from nfs-client's own defaults instead of
# duplicating them here — a second copy is exactly what would let this
# script keep passing (or start failing) against a mount the role no
# longer produces. host_vars overrides aren't read: this check is a
# smoke test of the role's own defaults, not of whatever a given host's
# local overrides happen to be.
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
defaults="$repo_root/ansible/roles/nfs-client/defaults/main.yml"
local_root="$(awk -F': *' '/^nfs_client_local_root:/ { print $2; exit }' "$defaults")"
check_uid="$(awk -F': *' '/^nfs_client_check_uid:/ { print $2; exit }' "$defaults")"
mounts="$(awk '/^nfs_client_mounts:/ { f=1; next } f && /^  - / { printf "%s ", $2 } f && !/^  - / { exit }' "$defaults")"
[[ -n "$local_root" && -n "$check_uid" && -n "$mounts" ]] || {
  echo "check-platform: could not read nfs_client_local_root/check_uid/mounts from $defaults" >&2
  exit 1
}

remote_script=$(cat <<'REMOTE'
set -euo pipefail

echo "ZFS pools ONLINE"
zpool list -H -o name,health | awk -F'\t' '$2 != "ONLINE" { print "  not ONLINE: " $0; exit 1 }'

echo "k3s node Ready"
sudo k3s kubectl get nodes --no-headers | awk '$2 != "Ready" { print "  not Ready: " $0; exit 1 }'

echo "Flux controllers healthy"
sudo k3s kubectl get deployments -n flux-system --no-headers \
  | awk '{ split($2, r, "/"); if (r[1] != r[2]) { print "  not ready: " $0; exit 1 } }'

echo "GPU visible to a pod"
sudo k3s kubectl run check-platform-gpu --rm -i --restart=Never \
  --image=nvidia/cuda:12.6.0-base-ubuntu24.04 \
  --overrides='{"apiVersion":"v1","kind":"Pod","spec":{"containers":[{"name":"check-platform-gpu","image":"nvidia/cuda:12.6.0-base-ubuntu24.04","command":["nvidia-smi","-L"],"resources":{"limits":{"nvidia.com/gpu":"1"}}}]}}' \
  --command -- nvidia-smi -L

echo "NAS mounts present, non-root write proven"
for share in __MOUNTS__; do
  mountpoint -q "__LOCAL_ROOT__/$share"
  f="__LOCAL_ROOT__/$share/.check-platform-nonroot"
  setpriv --reuid=__CHECK_UID__ --regid=__CHECK_UID__ --clear-groups bash -c "echo ok > \"$f\"; rm -f \"$f\""
done

echo "sops-age secret present"
sudo k3s kubectl get secret sops-age -n flux-system >/dev/null

echo "No pending reboot"
[ ! -f /var/run/reboot-required ]
REMOTE
)
remote_script=${remote_script//__MOUNTS__/$mounts}
remote_script=${remote_script//__LOCAL_ROOT__/$local_root}
remote_script=${remote_script//__CHECK_UID__/$check_uid}

ssh "$node1_host" 'bash -s' <<< "$remote_script"

echo "check-platform: all invariants hold"
