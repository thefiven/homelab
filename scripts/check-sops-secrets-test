#!/usr/bin/env bash
# shellcheck disable=SC2015  # ok/bad never fail; A && B || C is exhaustive here
# Self-check for the sops-metadata-policy pre-commit hook (ADR-0009, #73).
#
# Tests the two things that actually enforce the policy, directly and
# without a pre-commit install: scripts/check-sops-secrets itself (does it
# accept/reject correctly), and .pre-commit-config.yaml's `files:` regex
# (does it scope to secrets/, unanchored, same as .sops.yaml's own
# path_regex). No git-init/pre-commit dependency: this is what pre-commit
# would run and what would route a commit to it, tested at that level
# instead of through the framework's plumbing.
set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/check-sops-secrets-test.XXXXXX")
trap 'rm -rf "$scratch"' EXIT

files_regex=$(grep -m1 '^\s*files:' "$REPO_ROOT/.pre-commit-config.yaml" | sed -E 's/^\s*files:\s*//')

fail=0
ok()   { echo "ok   - $1"; }
bad()  { echo "FAIL - $1"; fail=1; }

# 1. files: regex scopes to secrets/, unanchored (nested paths included),
#    and excludes paths outside secrets/.
[[ "secrets/plain.yaml"          =~ $files_regex ]] && ok "files regex matches secrets/plain.yaml"          || bad "files regex should match secrets/plain.yaml"
[[ "apps/foo/secrets/bar.yaml"   =~ $files_regex ]] && ok "files regex matches nested apps/foo/secrets/bar.yaml" || bad "files regex should match nested secrets/ paths"
[[ "outside/plain.yaml"          =~ $files_regex ]] && bad "files regex should not match outside/plain.yaml" || ok "files regex excludes outside/plain.yaml"

# 2. the hook script itself: reject plaintext, accept a real encrypted file.
printf 'apiVersion: v1\nkind: Secret\nstringData:\n  ping: pong\n' > "$scratch/plain.yaml"
if "$REPO_ROOT/scripts/check-sops-secrets" "$scratch/plain.yaml" >/dev/null 2>&1; then
  bad "hook should reject an unencrypted secret"
else
  ok "hook rejects an unencrypted secret"
fi

if "$REPO_ROOT/scripts/check-sops-secrets" "$REPO_ROOT/workloads/smoke/secrets/test-secret.sops.yaml" >/dev/null 2>&1; then
  ok "hook accepts the repo's real encrypted secret"
else
  bad "hook should accept workloads/smoke/secrets/test-secret.sops.yaml"
fi

exit "$fail"
