#!/usr/bin/env bash
# Runs every hardware-free self-check in the repo (#116), stopping at the
# first failure — the one entry point a contributor or CI job runs instead
# of invoking each script's --self-check separately.
set -euo pipefail
DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
"$DIR/provision-state-pool" --self-check
"$DIR/build-media" --self-check
"$DIR/check-sops-secrets-test"

# Kustomization under workloads/immich parses and builds cleanly (#130),
# same check kustomize-controller runs against it every reconcile, without
# needing a live cluster. SOPS ciphertext still parses as valid YAML, so
# this doesn't need a decryption key.
kubectl kustomize "$DIR/../workloads/immich" >/dev/null

# Same for workloads/observability (#160/#170). Its two SOPS secrets
# (ntfy topic, Healthchecks ping URLs) aren't committed yet -
# scripts/observability-secrets-setup is a human-only wizard (#169) - and
# this build has to keep passing without them: the Deployment only
# references their Secret names in a volume, which kustomize never resolves.
kubectl kustomize "$DIR/../workloads/observability" >/dev/null

# Same for workloads/backup (#161-05): the restic postgres-dump and
# restic-check CronJobs, and their three SOPS secrets (repository password,
# duplicated Postgres credentials, duplicated Healthchecks pings - 161-02
# through 161-04).
kubectl kustomize "$DIR/../workloads/backup" >/dev/null

# Same for workloads/ingress (162-05/#182): the cloudflared Deployment
# (#180) only references the cloudflare-tunnel-token Secret by name
# (secretKeyRef), so this builds without it - neither that secret nor the
# Cloudflare API token exists yet (both are scripts/ingress-secrets-setup's
# job, #179).
kubectl kustomize "$DIR/../workloads/ingress" >/dev/null

# Same for workloads/smoke (162-05/#182): the whoami backend and catch-all
# Ingress added by #181 sit alongside #101's SOPS-decryption test-secret,
# now under their own kustomization.yaml so this entry point can build them.
kubectl kustomize "$DIR/../workloads/smoke" >/dev/null
