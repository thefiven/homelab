#!/usr/bin/env bash
# Loads the daily age identity into a running cluster as the `sops-age`
# secret Flux's kustomize-controller reads to decrypt SOPS-encrypted
# manifests (ADR-0009, #72). One-time, per that ADR's bootstrap step: needs
# a live k3s cluster with Flux already installed (scripts/flux-bootstrap,
# #71) and the daily identity already generated (scripts/sops-age-setup).
# Only the daily identity ever goes into the cluster; the recovery
# identity stays offline in Google Password Manager.
#
# Safe to re-run (e.g. after rotating the daily identity on suspected
# compromise, per ADR-0009): apply is idempotent where create is not.
set -euo pipefail

command -v kubectl >/dev/null || {
  echo "sops-age-bootstrap: kubectl not found" >&2
  exit 1
}

# Default path kept in sync with scripts/sops-age-setup's SOPS_DIR/DAILY_KEY_FILE.
age_key_file="${SOPS_AGE_KEY_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/sops/age/keys.txt}"
[[ -f "$age_key_file" ]] || {
  echo "sops-age-bootstrap: daily age identity not found at $age_key_file (run scripts/sops-age-setup first)" >&2
  exit 1
}

kubectl create secret generic sops-age \
  --namespace=flux-system \
  --from-file=age.agekey="$age_key_file" \
  --dry-run=client -o yaml \
  | kubectl apply -f -
