---
# Templated by the `admin-kubeconfig` role (ADR-0019, #244/#246/#249).
# Contains a live bearer token (admin_kubeconfig_token), never log this
# file's rendered content; the task that writes it is no_log: true.
#
# certificate-authority-data is admin_kubeconfig_ca_data as-is: it comes
# from an ansible.builtin.slurp of node1's server-ca.crt, which already
# base64-encodes the file it reads, the same encoding this field expects.
# No re-encoding here would double-encode it.
apiVersion: v1
kind: Config
current-context: {{ admin_kubeconfig_context_name }}
clusters:
  - name: {{ admin_kubeconfig_cluster_name }}
    cluster:
      server: https://{{ admin_kubeconfig_server_ip }}:{{ k3s_server_port }}
      certificate-authority-data: {{ admin_kubeconfig_ca_data }}
contexts:
  - name: {{ admin_kubeconfig_context_name }}
    context:
      cluster: {{ admin_kubeconfig_cluster_name }}
      user: {{ admin_access_service_account }}
users:
  - name: {{ admin_access_service_account }}
    user:
      token: {{ admin_kubeconfig_token }}
